# Copy to a directory outside the web root and fill it in. Never commit the filled copy.
#
# n8n reads these via `--env-file` (see n8n/docker-compose.yml); the workflow references
# them as $env.* (requires N8N_BLOCK_ENV_ACCESS_IN_NODE=false).

# --- Node 3: LLM classification -------------------------------------------
# Any provider that speaks OpenAI's chat-completions protocol. Leave AI_BASE_URL
# empty for OpenAI itself.
#
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter      https://openrouter.ai/api/v1
#   Groq            https://api.groq.com/openai/v1
#   DeepSeek        https://api.deepseek.com/v1
#   Ollama (local)  http://host.docker.internal:11434/v1
AI_BASE_URL=
AI_API_KEY=
# Must be a model the endpoint serves: gemini-2.5-flash, gpt-4o-mini, llama3.2 …
AI_MODEL=

# --- Node 5: Telegram delivery --------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Target group id — negative number, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# --- Node 0: webhook authenticity -----------------------------------------
# The same value as the "Secret" field of the WooCommerce webhook. Every delivery is
# signed with it; a request whose X-WC-Webhook-Signature does not match is rejected
# before anything else runs.
#
#   php -r 'echo bin2hex(random_bytes(32));'
WC_WEBHOOK_SECRET=

# --- Instance -------------------------------------------------------------
# Encrypts credentials stored by n8n. Must stay stable: change it and existing
# credentials become unreadable. Keep a copy outside this file.
#
#   php -r 'echo bin2hex(random_bytes(32));'
N8N_ENCRYPTION_KEY=
