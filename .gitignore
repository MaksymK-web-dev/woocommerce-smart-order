# ─────────────────────────────────────────────────────────────────────
# Deny by default.
#
# This directory is a WordPress document root, not a source tree: it holds
# core, vendor plugins, uploads, wp-config.php and the Codewhale session
# state. Committing any of it would be noise at best and a credential leak
# at worst.
#
# Everything is ignored, then only this project's own code is re-included.
# A new file cannot be committed by accident — it has to be listed below.
# ─────────────────────────────────────────────────────────────────────
/*

# ─── Project artifacts ──────────────────────────────────────────────
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/n8n/
!/tools/
!/scripts/

# ─── Our own WordPress code only ────────────────────────────────────
!/wp-content/
/wp-content/*
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/woocommerce-smart-order/
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/wso-local-webhook-transport.php

# ─── Secrets: never, under any path ─────────────────────────────────
.env
*.env
!.env.example
.codewhale/
/wp-config.php

# ─── Everything else in the web root ────────────────────────────────
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
/.osp/
/.idea/

# ─── OS and editor noise ────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
node_modules/
