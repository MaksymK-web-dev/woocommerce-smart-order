{
  "name": "maksymk-web-dev/woocommerce-smart-order",
  "description": "Classifies the customer comment on a new WooCommerce order for delivery-time requests and notifies the manager's Telegram group.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Maksym Krokhal",
      "homepage": "https://github.com/MaksymK-web-dev"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "php -l wp-content/plugins/woocommerce-smart-order/woocommerce-smart-order.php",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "test": "phpunit",
    "check": [
      "@cs",
      "@test"
    ]
  }
}
